  {
    "name": "walking_accessibility",
    "title": null,
    "description": "School-to-nearest-library network analysis. Export CSV, exact keyed routes, summary and report. Include snap connectors in destination choice and totals. New run_id required. A closure {u,v} removes both directions and all parallel edges; no closures means baseline. Threshold <=1850 m; speed is an explicit scenario assumption, never measured.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "city": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "threshold_m": {
          "default": 1200,
          "type": "number"
        },
        "speed_kph": {
          "default": 4.8,
          "type": "number"
        },
        "closures": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": {
                  "type": "integer"
                },
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "city",
        "run_id"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "icons": null,
