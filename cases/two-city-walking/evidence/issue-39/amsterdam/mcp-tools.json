  {
    "name": "walking_route",
    "title": null,
    "description": "One to three length-shortest ORIGINAL-graph paths, exact parallel keys and connector costs. Optional closed_links [{u,v}] annotates each rank with uses_closed_link, exact closed_edges_used and avoids_all_declared_closed_links; it does not remove links or reroute. Both directions/all parallel keys are checked. path_overlap reports shared keyed edges and physical links: k-shortest alternatives may overlap and all may use a closed link. Use walking_accessibility with closures for the actual closure scenario; these are unverified general walking proxies.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "city": {
          "type": "string"
        },
        "origin_id": {
          "type": "string"
