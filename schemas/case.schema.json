{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "id", "tool_id", "status", "data_class", "assets", "input_binding", "engine_status", "mcp_binding_status", "expected_result_status", "ready_to_run", "blockers"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "tool_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "admitted"]},
    "data_class": {"enum": ["upstream_synthetic_example", "project_observations", "declared_scenario"]},
    "ready_to_run": {"type": "boolean"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "municipal_case": {
      "type": "object",
      "required": ["municipality", "question", "data_access", "harvest_manifest", "native_evidence", "mcp_evidence", "reproduction_evidence"],
      "properties": {
        "municipality": {
          "type": "object",
          "required": ["country_code", "geographic_id", "name"],
          "properties": {
            "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
            "geographic_id": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1}
          }
        },
        "question": {"type": "string", "minLength": 1},
        "data_access": {"enum": ["public_reproducible", "restricted_operator"]},
        "harvest_manifest": {"type": "string", "minLength": 1},
        "native_evidence": {"type": "string", "minLength": 1},
        "mcp_evidence": {"type": "string", "minLength": 1},
        "reproduction_evidence": {"type": "string", "minLength": 1}
      }
    },
    "assets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "url", "source_id", "sha256", "bytes", "license_status"],
        "properties": {
          "file": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
          "url": {"type": "string"},
          "source_id": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1},
          "license_status": {"enum": ["scope_review_pending", "reviewed_for_declared_use"]}
        }
      }
    }
  }
}
